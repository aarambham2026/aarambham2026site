generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Registration {
  id              String   @id @default(cuid())
  registrationId  String   @unique
  teamLeaderName  String
  numberOfMembers Int
  eventCategory   String
  email           String
  phone           String
  queuePosition   Int
  slotStartTime   String
  slotEndTime     String
  status          String   @default("REGISTERED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EventSettings {
  id             String   @id @default("default")
  eventStartTime String   @default("14:00")
  musicDuration  Int      @default(10)
  danceDuration  Int      @default(10)
  setupGap       Int      @default(2)
  updatedAt      DateTime @updatedAt
}
