generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id                  String   @id @default(cuid())
  registrationId      String   @unique
  teamLeaderName      String
  rollNo              String?
  department          String?
  year                String?
  format              String?
  numberOfMembers     Int
  eventCategory       String
  performanceName     String?
  performanceDuration Int      @default(10)
  email               String
  phone               String
  membersList         String?
  queuePosition       Int
  slotStartTime       String
  slotEndTime         String
  status              String   @default("REGISTERED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model EventSettings {
  id             String   @id @default("default")
  eventStartTime String   @default("14:00")
  musicDuration  Int      @default(10)
  danceDuration  Int      @default(10)
  setupGap       Int      @default(2)
  updatedAt      DateTime @updatedAt
}
